@model IEnumerable<MarroquineriaMarcani.Models.FlujoCaja>

@{
    ViewData["Title"] = "Flujo de Caja";
    decimal totalIngresos = ViewBag.TotalIngresos ?? 0;
    decimal totalEgresos = ViewBag.TotalEgresos ?? 0;
    decimal saldoDisponible = ViewBag.SaldoDisponible ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="brand-font">Flujo de Caja</h2>
    <div>
        <a asp-action="ExportarExcel" class="btn btn-success me-2">
            <i class="bi bi-file-earmark-excel me-1"></i> Exportar a Excel
        </a>
        <button type="button" class="btn btn-marcani" data-bs-toggle="modal" data-bs-target="#modalRegistrarMovimiento">
            <i class="bi bi-plus-lg me-1"></i> Registrar Movimiento
        </button>
    </div>
</div>

<!-- TARJETAS DE RESUMEN -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-custom p-3 border-success border-2">
            <small class="text-muted fw-bold">Total Ingresos</small>
            <h3 class="text-success fw-bold mt-2">+ @totalIngresos.ToString("N2") BOB</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-danger border-2">
            <small class="text-muted fw-bold">Total Egresos</small>
            <h3 class="text-danger fw-bold mt-2">- @totalEgresos.ToString("N2") BOB</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-primary border-2">
            <small class="text-muted fw-bold">Saldo Disponible</small>
            <h3 class="text-primary fw-bold mt-2">@saldoDisponible.ToString("N2") BOB</h3>
        </div>
    </div>
</div>

<!-- TABLA DE MOVIMIENTOS -->
<div class="card card-custom p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Descripción</th>
                    <th>Monto</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var esIngreso = item.Tipo == "Ingreso";
                        <tr>
                            <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge @(esIngreso ? "bg-success" : "bg-danger")">
                                    @item.Tipo
                                </span>
                            </td>
                            <td>@item.Descripcion</td>
                            <td class="fw-bold @(esIngreso ? "text-success" : "text-danger")">
                                @(esIngreso ? "+" : "-") @item.Monto.ToString("N2") BOB
                            </td>
                            <td class="text-center">
                                <form asp-action="Eliminar" asp-route-id="@item.IdFlujoCaja" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar este movimiento?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No hay movimientos registrados en el flujo de caja.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>