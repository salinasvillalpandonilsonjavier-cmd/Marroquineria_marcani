@model IEnumerable<MarroquineriaMarcani.Models.FlujoCaja>

@{
    ViewData["Title"] = "Flujo de Caja";
    decimal totalIngresos = ViewBag.TotalIngresos ?? 0m;
    decimal totalEgresos = ViewBag.TotalEgresos ?? 0m;
    decimal saldoTotal = ViewBag.SaldoTotal ?? 0m;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="brand-font">Flujo de Caja</h2>
    <button type="button" class="btn btn-marcani" data-bs-toggle="modal" data-bs-target="#modalCrearMovimiento">
        <i class="bi bi-plus-lg me-1"></i> Registrar Movimiento
    </button>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-success border-4">
            <span class="text-muted small">Total Ingresos</span>
            <h3 class="brand-font text-success mt-1 mb-0">+ @totalIngresos.ToString("N2") BOB</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-danger border-4">
            <span class="text-muted small">Total Egresos</span>
            <h3 class="brand-font text-danger mt-1 mb-0">- @totalEgresos.ToString("N2") BOB</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <span class="text-muted small">Saldo Disponible</span>
            <h3 class="brand-font mt-1 mb-0">@saldoTotal.ToString("N2") BOB</h3>
        </div>
    </div>
</div>

<div class="card card-custom p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Descripción</th>
                    <th>Monto</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (item.TipoMovimiento == "Ingreso")
                                {
                                    <span class="badge bg-success">Ingreso</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Egreso</span>
                                }
                            </td>
                            <td>@(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción" : item.Descripcion)</td>
                            <td class="fw-bold @(item.TipoMovimiento == "Ingreso" ? "text-success" : "text-danger")">
                                @(item.TipoMovimiento == "Ingreso" ? "+" : "-") @item.Monto.ToString("N2") BOB
                            </td>
                            <td class="text-center">
                                <form asp-action="Eliminar" asp-route-id="@item.IdMovimiento" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar este movimiento?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No hay movimientos de caja registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalCrearMovimiento" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background-color: var(--color-marron-oscuro); color: var(--color-beige);">
                <h5 class="modal-title brand-font" id="modalLabel">Nuevo Movimiento de Caja</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Crear" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tipo de Movimiento</label>
                        <select name="TipoMovimiento" class="form-select" required>
                            <option value="Ingreso">Ingreso</option>
                            <option value="Egreso">Egreso</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Monto (BOB)</label>
                        <input type="number" step="0.01" name="Monto" class="form-control" placeholder="0.00" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Descripción / Detalle</label>
                        <input type="text" name="Descripcion" class="form-control" placeholder="Ej. Compra de remaches, Pago de servicio" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-marcani">Guardar Movimiento</button>
                </div>
            </form>
        </div>
    </div>
</div>