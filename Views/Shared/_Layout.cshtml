<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Marroquinería Marcani</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">

    <style>
        :root {
            --color-beige: #F5F5DC;
            --color-cafe-claro: #A67B5B;
            --color-marron-oscuro: #4A2C2A;
            --color-negro: #1A1A1A;
        }

        body {
            font-family: 'Lora', serif;
            background-color: var(--color-beige);
            color: var(--color-negro);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        h1, h2, h3, h4, h5, h6, .brand-font {
            font-family: 'Playfair Display', serif;
        }

        .navbar-custom {
            background-color: var(--color-marron-oscuro);
        }

        .sidebar {
            background-color: var(--color-marron-oscuro);
            min-height: calc(100vh - 56px);
        }

        .sidebar .nav-link {
            color: var(--color-beige);
            margin: 4px 0;
            border-radius: 4px;
            transition: all 0.2s;
        }

        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background-color: var(--color-cafe-claro);
            color: #ffffff;
        }

        .card-custom {
            background-color: #ffffff;
            border: 1px solid var(--color-cafe-claro);
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }

        .btn-marcani {
            background-color: var(--color-cafe-claro);
            color: #ffffff;
            border: none;
        }

        .btn-marcani:hover {
            background-color: var(--color-marron-oscuro);
            color: var(--color-beige);
        }

        .alert-stock-critico {
            background-color: #4A2C2A;
            color: #F5F5DC;
            border-left: 5px solid #d9534f;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom px-3">
        <a class="navbar-brand brand-font fs-3 text-light" asp-controller="Home" asp-action="Index">Marroquinería Marcani</a>
        <div class="ms-auto d-flex align-items-center text-light">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <i class="bi bi-person-circle fs-5 me-2"></i>
                <span class="me-3">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-box-arrow-right"></i> Salir
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-box-arrow-in-right"></i> Ingresar
                </a>
            }
        </div>
    </nav>

    <div class="container-fluid flex-grow-1">
        <div class="row">
            <nav class="col-md-3 col-lg-2 sidebar p-3 collapse d-md-block">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Insumos" asp-action="Index">
                            <i class="bi bi-box-seam me-2"></i> Insumos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Productos" asp-action="Index">
                            <i class="bi bi-bag me-2"></i> Productos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Ventas" asp-action="Index">
                            <i class="bi bi-cart-check me-2"></i> Ventas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="FlujoCaja" asp-action="Index">
                            <i class="bi bi-cash-stack me-2"></i> Flujo de Caja
                        </a>
                    </li>

                    @if (User.IsInRole("Administrador"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Usuarios" asp-action="Index">
                                <i class="bi bi-people me-2"></i> Usuarios
                            </a>
                        </li>
                    }
                </ul>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>