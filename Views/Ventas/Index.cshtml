@model IEnumerable<MarroquineriaMarcani.Models.Venta>

@{
    ViewData["Title"] = "Gestión de Ventas";
    var productos = ViewBag.Productos as List<MarroquineriaMarcani.Models.Producto>;
}

<div class="container mt-4">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="brand-font fw-bold" style="color: #4A2C2A;">Registro de Ventas</h2>
        <button type="button" class="btn text-white fw-bold" style="background-color: #4A2C2A;" data-bs-toggle="modal" data-bs-target="#modalNuevaVenta">
            <i class="bi bi-cart-plus me-1"></i> Nueva Venta
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #4A2C2A; color: #F5F5DC;">
                    <tr>
                        <th>ID Venta</th>
                        <th>Fecha</th>
                        <th>Total Venta (BOB)</th>
                        <th>Utilidad Neta (BOB)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No hay ventas registradas.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.IdVenta</td>
                                <td>@item.FechaVenta.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold">@item.Total.ToString("0.00") BOB</td>
                                <td class="fw-bold text-success">+@item.UtilidadNeta.ToString("0.00") BOB</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Registrar Venta -->
<div class="modal fade" id="modalNuevaVenta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Registrar" method="post">
                <div class="modal-header text-white" style="background-color: #4A2C2A;">
                    <h5 class="modal-title fw-bold">Registrar Venta</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Seleccionar Producto Terminado</label>
                        <select name="idProducto" class="form-select" required>
                            <option value="">-- Seleccionar Producto --</option>
                            @if (productos != null)
                            {
                                @foreach (var p in productos)
                                {
                                    <option value="@p.IdProducto">
                                        @p.Nombre - Stock: @p.StockDisponible - Precio: @p.PrecioVenta.ToString("0.00") BOB
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Cantidad a Vender</label>
                        <input name="cantidad" type="number" min="1" class="form-control" value="1" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn text-white fw-bold" style="background-color: #4A2C2A;">Completar Venta</button>
                </div>
            </form>
        </div>
    </div>
</div>