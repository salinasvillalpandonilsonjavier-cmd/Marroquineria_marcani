@model IEnumerable<MarroquineriaMarcani.Models.Venta>

@{
    ViewData["Title"] = "Gestión de Ventas";
    var productos = ViewBag.Productos as List<MarroquineriaMarcani.Models.Producto> ?? new List<MarroquineriaMarcani.Models.Producto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="brand-font">Historial de Ventas</h2>
    <button type="button" class="btn btn-marcani" data-bs-toggle="modal" data-bs-target="#modalNuevaVenta">
        <i class="bi bi-cart-plus me-1"></i> Registrar Venta
    </button>
</div>

<div class="card card-custom p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>N° Venta</th>
                    <th>Fecha y Hora</th>
                    <th>Monto Total</th>
                    <th>Utilidad Neta</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@item.IdVenta</td>
                            <td>@item.FechaVenta.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-success">@item.Total.ToString("N2") BOB</td>
                            <td class="text-primary">+ @item.UtilidadNeta.ToString("N2") BOB</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No hay ventas registradas todavía.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalNuevaVenta" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background-color: var(--color-marron-oscuro); color: var(--color-beige);">
                <h5 class="modal-title brand-font" id="modalLabel">Nueva Venta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RegistrarVenta" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Producto</label>
                        <select name="idProducto" class="form-select" required>
                            <option value="">-- Seleccionar producto --</option>
                            @foreach (var prod in productos)
                            {
                                <option value="@prod.IdProducto">
                                    @prod.Nombre - @prod.PrecioVenta.ToString("N2") BOB (Stock: @prod.StockDisponible)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Cantidad</label>
                        <input type="number" name="cantidad" class="form-control" value="1" min="1" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-marcani">Realizar Venta</button>
                </div>
            </form>
        </div>
    </div>
</div>