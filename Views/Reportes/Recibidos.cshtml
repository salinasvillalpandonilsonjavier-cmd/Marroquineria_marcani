@model IEnumerable<MarroquineriaMarcani.Models.Reporte>

@{
    ViewData["Title"] = "Reportes Recibidos";
}

<h2><i class="bi bi-file-earmark-check me-2"></i>Reportes Recibidos (Contador)</h2>

<div class="card card-custom p-4 mt-3">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Fecha y Hora</th>
                <th>Título</th>
                <th>Descripción</th>
                <th>Archivo Adjunto</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><strong>@item.Titulo</strong></td>
                        <td>@item.Descripcion</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ArchivoRuta))
                            {
                                <a asp-controller="Reportes" asp-action="Descargar" asp-route-id="@item.IdReporte" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-download"></i> Descargar Archivo
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Sin archivo</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No se han recibido reportes aún.</td>
                </tr>
            }
        </tbody>
    </table>
</div>