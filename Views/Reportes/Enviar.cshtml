@{
    ViewData["Title"] = "Enviar Reporte";
}

<div class="container-fluid p-4">
    <h2 class="mb-4">
        <i class="bi bi-send me-2"></i>Enviar Reporte al Administrador
    </h2>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-controller="Reportes" asp-action="Enviar" method="post" enctype="multipart/form-data">
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Título del Reporte</label>
                    <input type="text" name="titulo" class="form-control" placeholder="Ej: Reporte de Cierre del Día" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Descripción / Detalle</label>
                    <textarea name="descripcion" class="form-control" rows="4" placeholder="Escriba aquí los detalles u observaciones..."></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Adjuntar Archivo (Excel o PDF)</label>
                    <input type="file" name="archivo" class="form-control" accept=".xlsx, .xls, .pdf" required />
                </div>

                <button type="submit" class="btn btn-primary px-4 py-2 mt-2">
                    <i class="bi bi-send-fill me-2"></i>Enviar Reporte
                </button>

            </form>
        </div>
    </div>
</div>