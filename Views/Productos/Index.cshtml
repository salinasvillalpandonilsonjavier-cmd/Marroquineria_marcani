@model IEnumerable<MarroquineriaMarcani.Models.Producto>

@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="brand-font">Gestión de Productos</h2>
    <button type="button" class="btn btn-marcani" data-bs-toggle="modal" data-bs-target="#modalCrearProducto">
        <i class="bi bi-plus-lg me-1"></i> Registrar Producto
    </button>
</div>

<div class="card card-custom p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Costo Fabricación</th>
                    <th>Precio Venta</th>
                    <th>Stock Disponible</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var sinStock = item.StockDisponible <= 0;
                        <tr>
                            <td class="fw-bold">@item.Nombre</td>
                            <td>@item.CostoFabricacion.ToString("N2") BOB</td>
                            <td class="fw-bold">@item.PrecioVenta.ToString("N2") BOB</td>
                            <td>@item.StockDisponible u.</td>
                            <td>
                                @if (sinStock)
                                {
                                    <span class="badge bg-danger">Agotado</span>
                                }
                                else if (item.StockDisponible <= 3)
                                {
                                    <span class="badge bg-warning text-dark">Poco Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Disponible</span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="Eliminar" asp-route-id="@item.IdProducto" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar este producto?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No hay productos registrados en el catálogo.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalCrearProducto" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background-color: var(--color-marron-oscuro); color: var(--color-beige);">
                <h5 class="modal-title brand-font" id="modalLabel">Nuevo Producto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Crear" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del Producto</label>
                        <input type="text" name="Nombre" class="form-control" placeholder="Ej. Billetera de Cuero" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Costo Fabricación (BOB)</label>
                            <input type="number" step="0.01" name="CostoFabricacion" class="form-control" placeholder="0.00" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Precio Venta (BOB)</label>
                            <input type="number" step="0.01" name="PrecioVenta" class="form-control" placeholder="0.00" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Stock Disponible</label>
                        <input type="number" name="StockDisponible" class="form-control" value="0" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-marcani">Guardar Producto</button>
                </div>
            </form>
        </div>
    </div>
</div>