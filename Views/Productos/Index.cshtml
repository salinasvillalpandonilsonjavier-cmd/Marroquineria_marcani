@model IEnumerable<MarroquineriaMarcani.Models.Producto>

@{
    ViewData["Title"] = "Gestión de Productos";
    var insumos = ViewBag.Insumos as List<MarroquineriaMarcani.Models.Insumo> ?? new List<MarroquineriaMarcani.Models.Insumo>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="brand-font">Gestión de Productos</h2>
    <button type="button" class="btn btn-marcani" data-bs-toggle="modal" data-bs-target="#modalCrearProducto">
        <i class="bi bi-plus-lg me-1"></i> Registrar Producto
    </button>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <div asp-validation-summary="All" class="mb-0"></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card card-custom p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Costo Fabricación</th>
                    <th>Precio Venta</th>
                    <th>Stock Disponible</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var sinStock = item.StockDisponible <= 0;
                        <tr>
                            <td class="fw-bold">@item.Nombre</td>
                            <td>@item.CostoFabricacion.ToString("N2") BOB</td>
                            <td class="fw-bold">@item.PrecioVenta.ToString("N2") BOB</td>
                            <td>@item.StockDisponible u.</td>
                            <td>
                                @if (sinStock)
                                {
                                    <span class="badge bg-danger">Agotado</span>
                                }
                                else if (item.StockDisponible <= 3)
                                {
                                    <span class="badge bg-warning text-dark">Poco Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Disponible</span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="Eliminar" asp-route-id="@item.IdProducto" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar este producto?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No hay productos registrados en el catálogo.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal para Crear Producto con Insumos -->
<div class="modal fade" id="modalCrearProducto" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color: var(--color-marron-oscuro); color: var(--color-beige);">
                <h5 class="modal-title brand-font" id="modalLabel">Nuevo Producto con Insumos</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Nombre del Producto</label>
                            <input type="text" name="Nombre" class="form-control" placeholder="Ej. Billetera de Cuero" required />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Precio Venta (BOB)</label>
                            <input type="text" name="PrecioVenta" class="form-control" placeholder="Ej: 50.00" required />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Stock a Fabricar</label>
                            <input type="number" name="StockAFabricar" class="form-control" value="1" min="1" required />
                        </div>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0">Insumos Requeridos por Unidad</h6>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="agregarFilaInsumo()">
                            <i class="bi bi-plus-circle me-1"></i> Añadir Insumo
                        </button>
                    </div>

                    <div id="contenedor-insumos">
                        <!-- Filas agregadas dinámicamente -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-marcani">Guardar y Fabricar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let indexInsumo = 0;

        function agregarFilaInsumo() {
            const contenedor = document.getElementById('contenedor-insumos');
            const fila = document.createElement('div');
            fila.className = 'row g-2 mb-2 align-items-center';

            let optionsInsumos = '<option value="">-- Seleccionar Insumo --</option>';
            @foreach (var insumo in insumos)
            {
                @:optionsInsumos += `<option value="@insumo.IdInsumo">@insumo.Nombre (Disponible: @insumo.StockActual @insumo.UnidadMedida)</option>`;
            }

            fila.innerHTML = `
                <div class="col-md-7">
                    <select name="Insumos[${indexInsumo}].InsumoId" class="form-select form-select-sm" required>
                        ${optionsInsumos}
                    </select>
                </div>
                <div class="col-md-4">
                    <input type="text" name="Insumos[${indexInsumo}].CantidadRequeridaStr" class="form-control form-control-sm" placeholder="Cant. (Ej: 0.2 o 0.5)" required />
                </div>
                <div class="col-md-1 text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.row').remove()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            `;

            contenedor.appendChild(fila);
            indexInsumo++;
        }

        document.getElementById('modalCrearProducto').addEventListener('shown.bs.modal', function () {
            if (document.getElementById('contenedor-insumos').children.length === 0) {
                agregarFilaInsumo();
            }
        });
    </script>
}