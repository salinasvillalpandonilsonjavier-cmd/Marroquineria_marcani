@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Marroquinería Marcani</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Lora&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #F5F5DC;
            font-family: 'Lora', serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background-color: #ffffff;
            border: 1px solid #A67B5B;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 400px;
        }
        .login-header {
            background-color: #4A2C2A;
            color: #F5F5DC;
            padding: 2rem 1.5rem;
            border-radius: 7px 7px 0 0;
            text-align: center;
        }
        .brand-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            margin: 0;
        }
        .btn-marcani {
            background-color: #A67B5B;
            color: #ffffff;
            border: none;
            width: 100%;
            padding: 0.6rem;
        }
        .btn-marcani:hover {
            background-color: #4A2C2A;
            color: #F5F5DC;
        }
    </style>
</head>
<body>

<div class="login-card">
    <div class="login-header">
        <h1 class="brand-title">Marroquinería Marcani</h1>
        <small>Sistema de Gestión</small>
    </div>
    <div class="p-4">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 mb-3 text-center small" role="alert">
                @ViewBag.Error
            </div>
        }

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold">Correo Electrónico</label>
                <input type="email" name="correo" class="form-control" placeholder="usuario@marcani.com" required />
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold">Contraseña</label>
                <input type="password" name="contrasena" class="form-control" placeholder="******" required />
            </div>
            <button type="submit" class="btn btn-marcani fw-bold">Ingresar al Sistema</button>
        </form>
    </div>
</div>

</body>
</html>