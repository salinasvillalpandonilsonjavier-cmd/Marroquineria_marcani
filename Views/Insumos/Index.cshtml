@model IEnumerable<MarroquineriaMarcani.Models.Insumo>

@{
    ViewData["Title"] = "Gestión de Insumos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="brand-font fw-bold" style="color: #4A2C2A;">Inventario de Insumos</h2>
        <button type="button" class="btn text-white fw-bold" style="background-color: #4A2C2A;" data-bs-toggle="modal" data-bs-target="#modalNuevoInsumo">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Insumo
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #4A2C2A; color: #F5F5DC;">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Stock Actual</th>
                        <th>Stock Mínimo</th>
                        <th>Unidad</th>
                        <th>Costo Unitario</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No hay insumos registrados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            bool enStockCritico = item.StockActual <= item.StockMinimo;
                            <tr style="@(enStockCritico ? "background-color: #fff3f3;" : "")">
                                <td>@item.IdInsumo</td>
                                <td class="fw-bold">@item.Nombre</td>
                                <td>@item.StockActual</td>
                                <td>@item.StockMinimo</td>
                                <td>@item.UnidadMedida</td>
                                <td>@item.CostoUnitario.ToString("0.00") BOB</td>
                                <td>
                                    @if (enStockCritico)
                                    {
                                        <!-- HU02: Indicador de stock mínimo en marrón #4A2C2A -->
                                        <span class="badge" style="background-color: #4A2C2A; color: #F5F5DC;">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Stock Crítico
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Normal</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <form asp-action="Eliminar" asp-route-id="@item.IdInsumo" method="post" onsubmit="return confirm('¿Desea eliminar este insumo?');" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para Registrar Nuevo Insumo -->
<div class="modal fade" id="modalNuevoInsumo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Crear" method="post">
                <div class="modal-header text-white" style="background-color: #4A2C2A;">
                    <h5 class="modal-title fw-bold">Registrar Nuevo Insumo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del Insumo</label>
                        <input name="Nombre" class="form-control" required placeholder="Ej. Cuero Vacuno, Hilo de Nylon" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Stock Actual</label>
                            <input name="StockActual" type="number" step="0.01" class="form-control" required value="0" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Stock Mínimo</label>
                            <input name="StockMinimo" type="number" step="0.01" class="form-control" required value="5" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Unidad de Medida</label>
                            <select name="UnidadMedida" class="form-select">
                                <option value="Metros">Metros</option>
                                <option value="M2">M²</option>
                                <option value="Unidad">Unidad</option>
                                <option value="Litros">Litros</option>
                                <option value="Kg">Kg</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Costo Unitario (BOB)</label>
                            <input name="CostoUnitario" type="number" step="0.01" class="form-control" required value="0.00" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn text-white fw-bold" style="background-color: #4A2C2A;">Guardar Insumo</button>
                </div>
            </form>
        </div>
    </div>
</div>