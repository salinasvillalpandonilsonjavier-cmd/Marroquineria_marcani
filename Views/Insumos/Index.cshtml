@model IEnumerable<MarroquineriaMarcani.Models.Insumo>

@{
    ViewData["Title"] = "Gestión de Insumos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="brand-font">Inventario de Insumos</h2>
    <button type="button" class="btn btn-marcani" data-bs-toggle="modal" data-bs-target="#modalCrearInsumo">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Insumo
    </button>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card card-custom p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Stock Actual</th>
                    <th>Stock Mínimo</th>
                    <th>Unidad</th>
                    <th>Costo Unitario</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var esCritico = item.StockActual <= item.StockMinimo;
                        <tr>
                            <td>@item.IdInsumo</td>
                            <td class="fw-bold">@item.Nombre</td>
                            <td>@item.StockActual.ToString("0.00")</td>
                            <td>@item.StockMinimo.ToString("0.00")</td>
                            <td>@item.UnidadMedida</td>
                            <td>@item.CostoUnitario.ToString("N2") BOB</td>
                            <td>
                                @if (esCritico)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i> Stock Crítico</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Normal</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <!-- Botón Editar -->
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-primary" 
                                            title="Editar Insumo"
                                            onclick="abrirModalEditar('@item.IdInsumo', '@item.Nombre', '@item.UnidadMedida', '@item.StockActual.ToString("0.00")', '@item.StockMinimo.ToString("0.00")', '@item.CostoUnitario.ToString("0.00")')">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <!-- Botón Eliminar -->
                                    <form asp-action="Eliminar" asp-route-id="@item.IdInsumo" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar este insumo?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Eliminar Insumo">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No hay insumos registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal para Crear Insumo -->
<div class="modal fade" id="modalCrearInsumo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background-color: var(--color-marron-oscuro); color: var(--color-beige);">
                <h5 class="modal-title brand-font">Registrar Nuevo Insumo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del Insumo</label>
                        <input type="text" name="Nombre" class="form-control" placeholder="Ej. Cuero Vacuno, Hilo de Nylon" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Stock Actual</label>
                            <input type="text" name="StockActualStr" class="form-control" placeholder="Ej. 10.00" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Stock Mínimo</label>
                            <input type="text" name="StockMinimoStr" class="form-control" placeholder="Ej. 5.00" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Unidad de Medida</label>
                            <select name="UnidadMedida" class="form-select" required>
                                <option value="Metros">Metros</option>
                                <option value="M²">M²</option>
                                <option value="Unidad">Unidad</option>
                                <option value="Litros">Litros</option>
                                <option value="Kg">Kg</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Costo Unitario (BOB)</label>
                            <input type="text" name="CostoUnitarioStr" class="form-control" placeholder="Ej. 15.50" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-marcani">Guardar Insumo</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para Editar / Reabastecer Insumo -->
<div class="modal fade" id="modalEditarInsumo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background-color: var(--color-marron-oscuro); color: var(--color-beige);">
                <h5 class="modal-title brand-font">Editar / Reabastecer Insumo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Editar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="edit_id" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del Insumo</label>
                        <input type="text" id="edit_nombre" name="Nombre" class="form-control" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Stock Actual</label>
                            <input type="text" id="edit_stockActual" name="StockActualStr" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Stock Mínimo</label>
                            <input type="text" id="edit_stockMinimo" name="StockMinimoStr" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Unidad de Medida</label>
                            <select id="edit_unidadMedida" name="UnidadMedida" class="form-select" required>
                                <option value="Metros">Metros</option>
                                <option value="M²">M²</option>
                                <option value="Unidad">Unidad</option>
                                <option value="Litros">Litros</option>
                                <option value="Kg">Kg</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Costo Unitario (BOB)</label>
                            <input type="text" id="edit_costoUnitario" name="CostoUnitarioStr" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-marcani">Actualizar Insumo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalEditar(id, nombre, unidad, stockActual, stockMinimo, costoUnitario) {
            document.getElementById('edit_id').value = id;
            document.getElementById('edit_nombre').value = nombre;
            document.getElementById('edit_unidadMedida').value = unidad;
            document.getElementById('edit_stockActual').value = stockActual;
            document.getElementById('edit_stockMinimo').value = stockMinimo;
            document.getElementById('edit_costoUnitario').value = costoUnitario;

            var modalEditar = new bootstrap.Modal(document.getElementById('modalEditarInsumo'));
            modalEditar.show();
        }
    </script>
}