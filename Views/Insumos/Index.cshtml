@model IEnumerable<MarroquineriaMarcani.Models.Insumo>

@{
    ViewData["Title"] = "Gestión de Insumos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="brand-font">Gestión de Insumos</h2>
    <button type="button" class="btn btn-marcani" data-bs-toggle="modal" data-bs-target="#modalCrearInsumo">
        <i class="bi bi-plus-lg me-1"></i> Registrar Insumo
    </button>
</div>

<div class="card card-custom p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Insumo</th>
                    <th>Unidad</th>
                    <th>Stock Actual</th>
                    <th>Stock Mínimo</th>
                    <th>Costo Unitario</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var enAlerta = item.StockActual <= item.StockMinimo;
                        <tr>
                            <td class="fw-bold">@item.Nombre</td>
                            <td>@item.UnidadMedida</td>
                            <td>@item.StockActual</td>
                            <td>@item.StockMinimo</td>
                            <td>@item.CostoUnitario.ToString("N2") BOB</td>
                            <td>
                                @if (enAlerta)
                                {
                                    <span class="badge bg-danger">Stock Bajo</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Suficiente</span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="Eliminar" asp-route-id="@item.IdInsumo" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar este insumo?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay insumos registrados en el inventario.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalCrearInsumo" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background-color: var(--color-marron-oscuro); color: var(--color-beige);">
                <h5 class="modal-title brand-font" id="modalLabel">Nuevo Insumo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Crear" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del Insumo</label>
                        <input type="text" name="Nombre" class="form-control" placeholder="Ej. Cuero Vacuno Premium" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Unidad de Medida</label>
                        <input type="text" name="UnidadMedida" class="form-control" placeholder="Ej. Metros, Piezas, Kg" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Stock Actual</label>
                            <input type="number" name="StockActual" class="form-control" value="0" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Stock Mínimo</label>
                            <input type="number" name="StockMinimo" class="form-control" value="5" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Costo Unitario (BOB)</label>
                        <input type="number" step="0.01" name="CostoUnitario" class="form-control" placeholder="0.00" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-marcani">Guardar Insumo</button>
                </div>
            </form>
        </div>
    </div>
</div>